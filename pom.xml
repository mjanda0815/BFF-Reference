<?xml version="1.0" encoding="UTF-8"?>
<!--
  BFF Reference Architecture — aggregator POM.

  This POM is *only* a Maven reactor: it groups the four runnable modules
  (bff + three downstream microservices) so a developer exploring the
  reference can build and test everything with a single `mvn verify`
  from the repository root.

  Each child module remains **self-contained** on purpose:
    * Its own Spring Boot parent (spring-boot-starter-parent).
    * Its own dependency list, JaCoCo gate, and packaging config.

  Rationale: the stack is meant as a *copy-paste blueprint*. A team that
  adopts only the BFF, or only one downstream service, should be able to
  cut it out of the reactor without inheriting shared parent-POM magic
  that would then need to be replicated. Keep modules independent; let
  this file do nothing but list them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.bafa</groupId>
    <artifactId>bff-reference-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>bff-reference-parent</name>
    <description>Aggregator POM for the BAFA BFF reference architecture.</description>

    <modules>
        <module>bff</module>
        <module>services/user-service</module>
        <module>services/notification-service</module>
        <module>services/activity-service</module>
    </modules>

    <!--
      Security scan wired into every `mvn verify` on the aggregator.
      It deliberately lives here — not in the child POMs — because the
      OWASP aggregate goal walks the whole reactor once and produces a
      single merged report at target/dependency-check-report.{html,json}.

      First run downloads the NVD data (~1 GB) and takes 20-40 min. With
      a free NVD API key (env var NVD_API_KEY) it finishes in ~2 min.
      Subsequent runs reuse the cached NVD data under
      ~/.m2/repository/org/jeremylong/open-vulnerability-store/.

      failBuildOnCVSS=7 fails the build on HIGH or CRITICAL (CVSSv3 >= 7).
      False positives must be suppressed in dependency-check-suppressions.xml
      at the repo root — each entry requires a <notes> block explaining WHY
      the CVE does not apply, so the reasoning survives future re-audits.

      Override knobs:
        -DskipOwasp                — skip the scan for a single build
        -DfailBuildOnCVSS=<n>      — adjust severity gate (e.g. 8 = CRITICAL only)
        -DossindexAnalyzerEnabled=true   — re-enable OSS Index (requires reg'd token)
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.2.2</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <skip>${skipOwasp}</skip>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- OSS Index is unauthenticated-rate-limited and flakey on hobby-scale scans. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <suppressionFiles>
                        <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <skipOwasp>false</skipOwasp>
    </properties>
</project>
